{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>joshyorko/renovate-config:org-inherited-config"
  ],

  "homebrew": {
    "managerFilePatterns": [
      "/(^|/)Brewfile$/",
      "/\\.Brewfile$/"
    ]
  },

  "packageRules": [
    {
      "groupName": "Dudley Homebrew payload",
      "matchManagers": ["homebrew"]
    }
  ]
}

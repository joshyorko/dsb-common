#!/usr/bin/env bash
set -euo pipefail

DUDLEY_THEME_BIN_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1
    pwd -P
)"
readonly DUDLEY_THEME_BIN_DIR
DUDLEY_THEME_LIB_DIR="$(
    cd -- "$DUDLEY_THEME_BIN_DIR/../lib" >/dev/null 2>&1
    pwd -P
)"
readonly DUDLEY_THEME_LIB_DIR
export PYTHONPATH="$DUDLEY_THEME_LIB_DIR${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m dudley_theme.cli "$@"

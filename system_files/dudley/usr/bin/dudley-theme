#!/usr/bin/env bash
# Apply Dudley-managed theme assets without requiring root.
set -euo pipefail

readonly THEMES_DIR="${DUDLEY_THEMES_DIR:-/usr/share/dudley/themes}"
readonly USER_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly CONFIG_DIR="$USER_CONFIG_HOME/dudley"
readonly STATE_FILE="$CONFIG_DIR/theme"
readonly GENERATED_DIR="$CONFIG_DIR/generated"
readonly RECEIPT_FILE="$CONFIG_DIR/theme-receipt.json"
readonly WALLPAPER_BIN="${DUDLEY_WALLPAPER_BIN:-/usr/bin/dudley-wallpaper}"

usage() {
    echo "Usage: dudley-theme {list|current|apply <theme-id> [--force]|reset}" >&2
}

manifest_value() {
    python3 - "$1" "$2" <<'PY'
import json, pathlib, sys
value = json.loads(pathlib.Path(sys.argv[1]).read_text())
for key in sys.argv[2].split("."):
    value = value[key]
print(value)
PY
}

merge_vscode() {
    local fragment="$1"
    local settings
    for settings in \
        "$HOME/.config/Code/User/settings.json" \
        "$HOME/.config/Code - Insiders/User/settings.json"; do
        [[ -f "$settings" ]] || continue
        python3 - "$settings" "$fragment" <<'PY'
import json, pathlib, sys
target, fragment = map(pathlib.Path, sys.argv[1:])
update = json.loads(fragment.read_text())

def skip_trivia(text, index):
    while index < len(text):
        if text[index].isspace():
            index += 1
        elif text.startswith("//", index):
            newline = text.find("\n", index + 2)
            index = len(text) if newline < 0 else newline + 1
        elif text.startswith("/*", index):
            end = text.find("*/", index + 2)
            if end < 0:
                raise ValueError("unterminated JSONC block comment")
            index = end + 2
        else:
            break
    return index

def string_end(text, start):
    index = start + 1
    while index < len(text):
        if text[index] == "\\":
            index += 2
        elif text[index] == '"':
            return index + 1
        else:
            index += 1
    raise ValueError("unterminated JSONC string")

def matching_close(text, start):
    pairs = {"{": "}", "[": "]"}
    stack = [pairs[text[start]]]
    index = start + 1
    while index < len(text):
        if text[index] == '"':
            index = string_end(text, index)
        elif text.startswith("//", index) or text.startswith("/*", index):
            index = skip_trivia(text, index)
        elif text[index] in pairs:
            stack.append(pairs[text[index]])
            index += 1
        elif text[index] == stack[-1]:
            stack.pop()
            if not stack:
                return index
            index += 1
        else:
            index += 1
    raise ValueError("unterminated JSONC collection")

def value_end(text, start):
    if text[start] == '"':
        return string_end(text, start)
    if text[start] in "[{":
        return matching_close(text, start) + 1
    index = start
    while index < len(text) and text[index] not in ",}":
        if text.startswith("//", index) or text.startswith("/*", index):
            break
        index += 1
    return index

def members(text, start):
    close = matching_close(text, start)
    result = {}
    index = skip_trivia(text, start + 1)
    while index < close:
        if text[index] != '"':
            raise ValueError("JSONC object keys must be quoted")
        key_end = string_end(text, index)
        key = json.loads(text[index:key_end])
        index = skip_trivia(text, key_end)
        if index >= close or text[index] != ":":
            raise ValueError(f"missing colon after JSONC key {key!r}")
        value_start = skip_trivia(text, index + 1)
        end = value_end(text, value_start)
        result[key] = (value_start, end)
        index = skip_trivia(text, end)
        if index < close and text[index] == ",":
            index = skip_trivia(text, index + 1)
        elif index < close:
            raise ValueError(f"missing comma after JSONC key {key!r}")
    return close, result

def formatted(value, continuation_indent):
    rendered = json.dumps(value, indent=2)
    return rendered.replace("\n", "\n" + continuation_indent)

def merge_object(text, start, changes):
    _, existing = members(text, start)
    missing = {key: value for key, value in changes.items() if key not in existing}

    for key in sorted((key for key in changes if key in existing), key=lambda item: existing[item][0], reverse=True):
        value_start, end = existing[key]
        value = changes[key]
        if isinstance(value, dict) and text[value_start] == "{":
            replacement = merge_object(text[value_start:end], 0, value)
        else:
            line_start = text.rfind("\n", 0, value_start) + 1
            indent = text[line_start:value_start]
            replacement = formatted(value, indent)
        text = text[:value_start] + replacement + text[end:]

    if not missing:
        return text

    close, existing = members(text, start)
    if existing:
        _, last_end = max(existing.values(), key=lambda item: item[1])
        after_last = skip_trivia(text, last_end)
        if after_last >= close or text[after_last] != ",":
            text = text[:last_end] + "," + text[last_end:]
            close += 1

    close_line_start = text.rfind("\n", 0, close) + 1
    close_indent = text[close_line_start:close]
    if close_indent.strip():
        close_line_start = close
        close_indent = ""
        prefix = "\n"
    else:
        prefix = ""
    child_indent = close_indent + "  "
    additions = []
    for key, value in missing.items():
        additions.append(
            f"{child_indent}{json.dumps(key)}: {formatted(value, child_indent)}"
        )
    block = prefix + ",\n".join(additions) + "\n"
    return text[:close_line_start] + block + text[close_line_start:]

current = target.read_text()
root = skip_trivia(current, 0)
if root >= len(current) or current[root] != "{":
    raise ValueError(f"{target} must contain a JSONC object")
merged = merge_object(current, root, update)
temporary = target.with_suffix(".json.dudley-tmp")
temporary.write_text(merged)
temporary.replace(target)
PY
    done
}

ensure_line() {
    local path="$1"
    local line="$2"
    mkdir -p "$(dirname "$path")"
    touch "$path"
    if ! grep -Fqx -- "$line" "$path"; then
        [[ ! -s "$path" ]] || printf '\n' >>"$path"
        printf '%s\n' "$line" >>"$path"
    fi
}

remove_line() {
    local path="$1"
    local line="$2"
    [[ -f "$path" ]] || return 0
    local temporary="${path}.dudley-tmp"
    grep -Fvx -- "$line" "$path" >"$temporary" || true
    mv "$temporary" "$path"
}

link_generated_assets() {
    mkdir -p \
        "$USER_CONFIG_HOME/kitty" \
        "$USER_CONFIG_HOME/ghostty/themes" \
        "$USER_CONFIG_HOME/nvim/plugin" \
        "$USER_CONFIG_HOME/btop/themes"
    ln -sfnT -- "$GENERATED_DIR/kitty.conf" "$USER_CONFIG_HOME/kitty/dudley-theme.conf"
    ln -sfnT -- "$GENERATED_DIR/ghostty.theme" "$USER_CONFIG_HOME/ghostty/themes/dudley-theme"
    ln -sfnT -- "$GENERATED_DIR/neovim.lua" "$USER_CONFIG_HOME/nvim/plugin/dudley-theme.lua"
    ln -sfnT -- "$GENERATED_DIR/btop.theme" "$USER_CONFIG_HOME/btop/themes/dudley-theme.theme"
    ensure_line "$USER_CONFIG_HOME/kitty/kitty.conf" "include dudley-theme.conf"
    ensure_line "$USER_CONFIG_HOME/ghostty/config" "theme = dudley-theme"
    ensure_line "$USER_CONFIG_HOME/btop/btop.conf" 'color_theme = "dudley-theme"'
}

receipt_matches() {
    python3 - "$1" "$2" <<'PY'
import json, pathlib, sys
manifest_path, receipt_path = map(pathlib.Path, sys.argv[1:])
try:
    manifest = json.loads(manifest_path.read_text())
    receipt = json.loads(receipt_path.read_text())
except (OSError, ValueError):
    raise SystemExit(1)
raise SystemExit(
    0
    if receipt.get("theme") == manifest.get("id")
    and receipt.get("theme_version") == manifest.get("version")
    else 1
)
PY
}

list_themes() {
    local manifest
    for manifest in "$THEMES_DIR"/*/manifest.json; do
        [[ -f "$manifest" ]] || continue
        printf '%s\t%s\n' "$(manifest_value "$manifest" id)" "$(manifest_value "$manifest" name)"
    done
}

current_theme() {
    [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || echo "none"
}

apply_theme() {
    local theme="$1"
    local force="${2:-}"
    [[ "$theme" =~ ^[a-z0-9][a-z0-9-]*$ ]] || {
        echo "Invalid theme id: $theme" >&2
        return 1
    }
    [[ -z "$force" || "$force" == "--force" ]] || { usage; return 2; }
    local root="$THEMES_DIR/$theme"
    local manifest="$root/manifest.json"
    [[ -f "$manifest" ]] || {
        echo "Unknown theme: $theme" >&2
        return 1
    }
    if [[ "$force" != "--force" && -f "$STATE_FILE" && "$(cat "$STATE_FILE")" == "$theme" &&
        -f "$RECEIPT_FILE" ]] && receipt_matches "$manifest" "$RECEIPT_FILE"; then
        echo "$theme is already applied"
        return 0
    fi

    mkdir -p "$GENERATED_DIR"
    install -m 0644 "$root/$(manifest_value "$manifest" assets.kitty)" "$GENERATED_DIR/kitty.conf"
    install -m 0644 "$root/$(manifest_value "$manifest" assets.ghostty)" "$GENERATED_DIR/ghostty.theme"
    install -m 0644 "$root/$(manifest_value "$manifest" assets.neovim)" "$GENERATED_DIR/neovim.lua"
    install -m 0644 "$root/$(manifest_value "$manifest" assets.btop)" "$GENERATED_DIR/btop.theme"
    link_generated_assets
    merge_vscode "$root/$(manifest_value "$manifest" assets.vscode)"

    if command -v dconf >/dev/null 2>&1; then
        dconf load / <"$root/$(manifest_value "$manifest" gnome.dconf)" || true
    elif command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
    fi
    if command -v gsettings >/dev/null 2>&1 &&
        gsettings writable org.gnome.desktop.interface accent-color >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface accent-color blue || true
    fi
    "$WALLPAPER_BIN" set "$theme/$(basename "$(manifest_value "$manifest" assets.default_wallpaper)")"

    printf '%s\n' "$theme" >"$STATE_FILE"
    python3 - "$manifest" "$RECEIPT_FILE" <<'PY'
import datetime, json, pathlib, sys
manifest = json.loads(pathlib.Path(sys.argv[1]).read_text())
receipt = {
    "schema_version": 1,
    "theme": manifest["id"],
    "theme_version": manifest["version"],
    "applied_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
}
pathlib.Path(sys.argv[2]).write_text(json.dumps(receipt, indent=2) + "\n")
PY
    echo "Applied $theme"
}

reset_theme() {
    rm -f -- \
        "$USER_CONFIG_HOME/kitty/dudley-theme.conf" \
        "$USER_CONFIG_HOME/ghostty/themes/dudley-theme" \
        "$USER_CONFIG_HOME/nvim/plugin/dudley-theme.lua" \
        "$USER_CONFIG_HOME/btop/themes/dudley-theme.theme"
    remove_line "$USER_CONFIG_HOME/kitty/kitty.conf" "include dudley-theme.conf"
    remove_line "$USER_CONFIG_HOME/ghostty/config" "theme = dudley-theme"
    remove_line "$USER_CONFIG_HOME/btop/btop.conf" 'color_theme = "dudley-theme"'
    rm -rf -- "$GENERATED_DIR"
    rm -f -- "$STATE_FILE" "$RECEIPT_FILE"
    if command -v gsettings >/dev/null 2>&1; then
        gsettings reset org.gnome.desktop.interface color-scheme || true
        gsettings reset org.gnome.desktop.interface accent-color || true
    fi
    echo "Dudley-managed theme state reset"
}

case "${1:-}" in
    list) [[ $# -eq 1 ]] || { usage; exit 2; }; list_themes ;;
    current) [[ $# -eq 1 ]] || { usage; exit 2; }; current_theme ;;
    apply) [[ $# -ge 2 && $# -le 3 ]] || { usage; exit 2; }; apply_theme "$2" "${3:-}" ;;
    reset) [[ $# -eq 1 ]] || { usage; exit 2; }; reset_theme ;;
    *) usage; exit 2 ;;
esac

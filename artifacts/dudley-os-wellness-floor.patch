diff --git a/build/validate-dudley-theme.sh b/build/validate-dudley-theme.sh
new file mode 100755
--- /dev/null
+++ b/build/validate-dudley-theme.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+default_file="/etc/dudley/theme-default"
+themes_dir="/usr/share/dudley/themes"
+
+[[ -f "${default_file}" ]] || exit 0
+theme="$(tr -d '[:space:]' <"${default_file}")"
+[[ -n "${theme}" ]] || {
+    echo "Empty ${default_file}" >&2
+    exit 1
+}
+[[ -f "${themes_dir}/${theme}/manifest.json" ]] || {
+    echo "Missing theme manifest for ${theme}" >&2
+    exit 1
+}
